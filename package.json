{
  "name": "olensiz",
  "version": "3.0.0",
  "description": "Óleńsiz — угадай казахскую песню по короткому фрагменту. Статичный сайт без бэкенда.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node scripts/verify-scoring.mjs > /dev/null && node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "verify": "node scripts/verify-scoring.mjs && node scripts/verify-search.mjs && node scripts/verify-contrast.mjs",
    "verify:scoring": "node scripts/verify-scoring.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:noscroll": "node scripts/verify-noscroll.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:catalog:fresh": "node scripts/build-catalog.mjs --fresh",
    "screenshots": "node scripts/screenshots.mjs",
    "og": "node scripts/make-og.mjs",
    "editor": "node scripts/editor-server.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {}
}